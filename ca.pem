"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":159,\"_86\":160,\"_88\":141},{\"_60\":138,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":139,\"_86\":140,\"_88\":141},\"6c649aaa70ea\",[146,147,148],[142],\"normal\",{\"_60\":143,\"_21\":102,\"_144\":145,\"_105\":68,\"_106\":-5,\"_36\":-5},\"44d2a9f8a63c\",\"href\",\"https://aiven.io/pricing\",{\"_60\":155,\"_21\":93,\"_94\":156,\"_96\":157},{\"_60\":152,\"_21\":93,\"_94\":153,\"_96\":154},{\"_60\":149,\"_21\":93,\"_94\":150,\"_96\":151},\"518bee58b7a3\",[],\".\",\"516906b151ed\",[143],\"aiven.io/pricing\",\"24c831d9dc5f\",[],\"Exact pricing for every service, plan, and cloud region is at \",\"0b39a6fcaf93\",[161],[],{\"_60\":162,\"_21\":93,\"_94\":163,\"_96\":164},\"1bb179925cdb\",[],\"All plans include automated backups, monitoring, and no hidden fees. You bill by the hour for actual usage, and you can upgrade or downgrade between tiers with a one-click change in the Aiven Console.\",\"c74c7436f8f7\",[172],\"level\",1,\"listItem\",\"bullet\",[],{\"_60\":173,\"_21\":93,\"_94\":174,\"_96\":175},\"baf16f5c94a3\",[],\"Premium: Enterprise-grade production. Larger cluster sizes, 30-day backup retention, optional synchronous replication, priority support add-ons.\",\"ad7315fbd32a\",[179],[],{\"_60\":180,\"_21\":93,\"_94\":181,\"_96\":182},\"845281714303\",[],\"Business: Recommended for production. Multi-node clusters with high availability, 14-day backup retention, and the 99.99% uptime SLA.\",\"6b083dcae3c8\",[186],[],{\"_60\":187,\"_21\":93,\"_94\":188,\"_96\":189},\"390c75de8a46\",[],\"Startup: Small production workloads with backup retention and basic high-availability options.\",\"331aa2fd591e\",[193],[],{\"_60\":194,\"_21\":93,\"_94\":195,\"_96\":196},\"8a801042f823\",[],\"Developer: From $5/month for PostgreSQL \u0026 MySQL (dedicated single VM: 1 CPU, 1 GB RAM, 8 GB storage) as well as OpenSearch, or $35/month for Kafka. Basic support, always-on. Built for side projects, MVPs, and dev environments.\",\"9b7c1a5b4c2e\",[200],[],{\"_60\":201,\"_21\":93,\"_94\":202,\"_96\":203},\"1b178b0ba1f3\",[],\"Free: PostgreSQL, MySQL, Kafka, OpenSearch and Valkey. No credit card required, no time limit. Services may power off after long periods of inactivity.\",\"f9ce26048371\",[207],[],{\"_60\":208,\"_21\":93,\"_94\":209,\"_96\":210},\"766942eb7b6b\",[],\"You can deploy your first service in under 10 minutes — no infrastructure setup, no configuration files, no cloud account required to start.\",\"439850e76609\",[214,215,216,217,218,219,220,221],\"Is Aiven suitable for production workloads?\",{\"_60\":271,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":272,\"_86\":273,\"_88\":141},{\"_60\":264,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":265,\"_86\":266,\"_88\":141},{\"_60\":257,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":258,\"_167\":168,\"_169\":170,\"_86\":259,\"_88\":141},{\"_60\":250,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":251,\"_167\":168,\"_169\":170,\"_86\":252,\"_88\":141},{\"_60\":243,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":244,\"_167\":168,\"_169\":170,\"_86\":245,\"_88\":141},{\"_60\":236,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":237,\"_167\":168,\"_169\":170,\"_86\":238,\"_88\":141},{\"_60\":229,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":230,\"_167\":168,\"_169\":170,\"_86\":231,\"_88\":141},{\"_60\":222,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":223,\"_86\":224,\"_88\":141},\"88a7684b873d\",[225],[],{\"_60\":226,\"_21\":93,\"_94\":227,\"_96\":228},\"24a79db243b3\",[],\"Proof points: WalkMe handles over 100,000 events per second on Aiven for Apache Kafka. Dojo processes its weekly payment transactions on Aiven. Sophos streams terabytes of security data daily across 9 regions.\",\"ac8fe3984938\",[232],[],{\"_60\":233,\"_21\":93,\"_94\":234,\"_96\":235},\"8aba38fb287f\",[],\"Access control: role-based access with audit logs for compliance-sensitive environments.\",\"7ca567703e85\",[239],[],{\"_60\":240,\"_21\":93,\"_94\":241,\"_96\":242},\"832f046e7b55\",[],\"Private networking: VPC peering and PrivateLink so traffic never traverses the public internet.\",\"a8c71bf9e584\",[246],[],{\"_60\":247,\"_21\":93,\"_94\":248,\"_96\":249},\"904a739e1015\",[],\"Compliance: SOC 2 Type II, ISO 27001, GDPR, and HIPAA-compliant infrastructure.\",\"625675d5cf0e\",[253],[],{\"_60\":254,\"_21\":93,\"_94\":255,\"_96\":256},\"f630f9826c5c\",[],\"99.99% uptime SLA on Business and Premium plans.\",\"e83e08eed696\",[260],[],{\"_60\":261,\"_21\":93,\"_94\":262,\"_96\":263},\"86973bf697b2\",[],\"High availability: multi-node clusters with automatic failover.\",\"0baa33d571f0\",[267],[],{\"_60\":268,\"_21\":93,\"_94\":269,\"_96\":270},\"b4d4c2bb6ee3\",[],\"For production use, Aiven provides:\",\"dc17edcc523b\",[274],[],{\"_60\":275,\"_21\":93,\"_94\":276,\"_96\":277},\"684b4f6f9eab\",[],\"Yes. Aiven runs mission-critical workloads for companies across fintech, retail, cybersecurity, and software, including teams processing hundreds of millions of payment transactions per week and streaming petabytes of data daily.\",\"ea07747abf15\",[281,282,283,284],\"How does Aiven compare to AWS RDS, Confluent, or Elastic Cloud?\",{\"_60\":306,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":307,\"_86\":308,\"_88\":141},{\"_60\":299,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":300,\"_167\":168,\"_169\":170,\"_86\":301,\"_88\":141},{\"_60\":292,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":293,\"_167\":168,\"_169\":170,\"_86\":294,\"_88\":141},{\"_60\":285,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":286,\"_167\":168,\"_169\":170,\"_86\":287,\"_88\":141},\"233db4de2865\",[288],[],{\"_60\":289,\"_21\":93,\"_94\":290,\"_96\":291},\"442422050edd\",[],\"vs Elastic Cloud: Elastic moved Elasticsearch to a non-open-source licence, although they've since dual-licensed some source code under AGPLv3. Aiven runs OpenSearch, which remains under the Apache 2.0 licence. Elastic Cloud is also limited to AWS, GCP, and Azure, whereas Aiven runs on any cloud. If licence compliance or cloud flexibility matters to your organisation, these are meaningful distinctions.\",\"7be742a23c0a\",[295],[],{\"_60\":296,\"_21\":93,\"_94\":297,\"_96\":298},\"8f54e131edf6\",[],\"vs Confluent Cloud: Confluent is built on a Confluent-specific Kafka distribution with proprietary extensions. Aiven runs standard Apache Kafka, the same open source version you'd run yourself, so there are no Confluent-specific APIs to learn or migrate away from.\",\"de4032d0dec6\",[302],[],{\"_60\":303,\"_21\":93,\"_94\":304,\"_96\":305},\"c8d824965ebc\",[],\"vs AWS RDS / Google Cloud SQL / Azure Database: Cloud-native managed databases tie your data layer to one provider's pricing, ecosystem, and roadmap. Aiven runs across all major clouds with the same interface, so you can move workloads between providers without re-architecting your data stack.\",\"0f8ed3cd2ae3\",[309],[],{\"_60\":310,\"_21\":93,\"_94\":311,\"_96\":312},\"15676106c756\",[],\"The main difference is cloud independence and open source fidelity.\",\"bf53e8322145\",[316,317,318],\"Which cloud providers does Aiven run on?\",{\"_60\":333,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":334,\"_86\":335,\"_88\":141},{\"_60\":326,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":327,\"_86\":328,\"_88\":141},{\"_60\":319,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":320,\"_86\":321,\"_88\":141},\"8fa922c8304f\",[322],[],{\"_60\":323,\"_21\":93,\"_94\":324,\"_96\":325},\"188b51d0b7dc\",[],\"You can switch cloud providers or regions without changing how your application connects to the service.\",\"44b468fb0130\",[329],[],{\"_60\":330,\"_21\":93,\"_94\":331,\"_96\":332},\"753134ce4c88\",[],\"You can also run Aiven in your own cloud account using Bring Your Own Cloud (BYOC). With BYOC, your data never leaves your environment: Aiven's control plane manages the service, but all compute and storage live in your own AWS, GCP, or Azure account. This is popular with teams that have strict data residency, compliance, or cost requirements.\",\"0822a69931dc\",[336],[],{\"_60\":337,\"_21\":93,\"_94\":338,\"_96\":339},\"4aaec2b3e24c\",[],\"Aiven runs on AWS, Google Cloud, Microsoft Azure, DigitalOcean, UpCloud and OVHcloud, across more than 100 regions worldwide.\",\"ed6df1d188af\",[343,344,345,346,347,348,349,350],\"Which open source tools and databases does Aiven support?\",{\"_60\":400,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":401,\"_86\":402,\"_88\":141},{\"_60\":393,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":394,\"_167\":168,\"_169\":170,\"_86\":395,\"_88\":141},{\"_60\":386,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":387,\"_167\":168,\"_169\":170,\"_86\":388,\"_88\":141},{\"_60\":379,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":380,\"_167\":168,\"_169\":170,\"_86\":381,\"_88\":141},{\"_60\":372,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":373,\"_167\":168,\"_169\":170,\"_86\":374,\"_88\":141},{\"_60\":365,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":366,\"_167\":168,\"_169\":170,\"_86\":367,\"_88\":141},{\"_60\":358,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":359,\"_167\":168,\"_169\":170,\"_86\":360,\"_88\":141},{\"_60\":351,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":352,\"_86\":353,\"_88\":141},\"7b07c9665802\",[354],[],{\"_60\":355,\"_21\":93,\"_94\":356,\"_96\":357},\"4ce2b9e7819a\",[],\"Every service runs the upstream open source version, not a proprietary fork. Standard connectors, drivers, and client libraries work out of the box, and you're never locked into Aiven-specific APIs.\",\"1f93272db111\",[361],[],{\"_60\":362,\"_21\":93,\"_94\":363,\"_96\":364},\"4db5b0cb3df8\",[],\"Agent tooling: Aiven Runtime\",\"1a7874a86b59\",[368],[],{\"_60\":369,\"_21\":93,\"_94\":370,\"_96\":371},\"7f27390a170a\",[],\"Governance: Aiven DataHub\",\"2e3de679300d\",[375],[],{\"_60\":376,\"_21\":93,\"_94\":377,\"_96\":378},\"30cba42c2ba9\",[],\"Search \u0026 observability: OpenSearch, Aiven for Metrics, Grafana\",\"6e0164ef8bac\",[382],[],{\"_60\":383,\"_21\":93,\"_94\":384,\"_96\":385},\"48e816a23050\",[],\"Analytics: ClickHouse\",\"50a9614869de\",[389],[],{\"_60\":390,\"_21\":93,\"_94\":391,\"_96\":392},\"a496b00f6c3a\",[],\"Streaming: Apache Kafka\",\"e40e7d2f60c6\",[396],[],{\"_60\":397,\"_21\":93,\"_94\":398,\"_96\":399},\"ed7ddd864279\",[],\"Databases: PostgreSQL, MySQL, Valkey (Redis-compatible)\",\"50ed66eb81ce\",[403],[],{\"_60\":404,\"_21\":93,\"_94\":405,\"_96\":406},\"e52b1792324c\",[],\"Aiven currently supports:\",\"2a4254dbdef3\",[410,411,412,413,414,415,416,417,418,419,420,421],\"How does the Aiven platform help developers?\",{\"_60\":526,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":527,\"_86\":528,\"_88\":141},{\"_60\":519,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":520,\"_86\":521,\"_88\":141},{\"_60\":512,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":513,\"_167\":168,\"_169\":170,\"_86\":514,\"_88\":141},{\"_60\":505,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":506,\"_167\":168,\"_169\":170,\"_86\":507,\"_88\":141},{\"_60\":498,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":499,\"_167\":168,\"_169\":170,\"_86\":500,\"_88\":141},{\"_60\":491,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":492,\"_167\":168,\"_169\":170,\"_86\":493,\"_88\":141},{\"_60\":484,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":485,\"_167\":168,\"_169\":170,\"_86\":486,\"_88\":141},{\"_60\":477,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":478,\"_167\":168,\"_169\":170,\"_86\":479,\"_88\":141},{\"_60\":470,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":471,\"_167\":168,\"_169\":170,\"_86\":472,\"_88\":141},{\"_60\":453,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":454,\"_167\":168,\"_169\":170,\"_86\":455,\"_88\":141},{\"_60\":446,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":447,\"_167\":168,\"_169\":170,\"_86\":448,\"_88\":141},{\"_60\":422,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":423,\"_86\":424,\"_88\":141},\"64e8e9f57abc\",[434,435,436],[425],{\"_60\":426,\"_21\":427,\"_427\":428,\"_106\":12,\"_36\":429},\"21ad05d0229f\",\"internalLink\",{\"_431\":432,\"_21\":433},{\"_21\":36,\"_40\":430},\"/case-studies/la-redoute-takes-control-of-cloud-costs-with-byoc\",\"_ref\",\"7455e64b-e73e-4edd-86fa-be656d250d3c\",\"reference\",{\"_60\":443,\"_21\":93,\"_94\":444,\"_96\":445},{\"_60\":440,\"_21\":93,\"_94\":441,\"_96\":442},{\"_60\":437,\"_21\":93,\"_94\":438,\"_96\":439},\"5304bd445a33\",[],\" \",\"39af06363663\",[426],\"Read more\",\"15c18c59e14d\",[],\"Proof point: La Redoute's team reported spending up to 90% of their day on maintenance before switching to Aiven. After migrating, they moved 25 databases in a single day and refocused engineers on product work. \",\"94fbed73af5e\",[449],[],{\"_60\":450,\"_21\":93,\"_94\":451,\"_96\":452},\"b24ed1ee362b\",[],\"Predictable pricing. Start with the Developer tier, which gives you always-on managed services sized for development, prototyping, and MVPs on a small, flat monthly fee. Current per-service prices are on the pricing page. Scale up any time.\",\"401098180723\",[462,463],[456],{\"_60\":457,\"_21\":427,\"_427\":458,\"_106\":12,\"_36\":459},\"b7bdaf0d02ad\",{\"_431\":461,\"_21\":433},{\"_21\":36,\"_40\":460},\"/mcp\",\"d22bb0b7-ebd3-4a59-b87c-ed5fdc87c744\",{\"_60\":467,\"_21\":93,\"_94\":468,\"_96\":469},{\"_60\":464,\"_21\":93,\"_94\":465,\"_96\":466},\"acc15514c0fe\",[],\". Connect AI agents and tools directly to your Aiven services, starting with PostgreSQL and Kafka, with more to come.\",\"87302f78a03d\",[457],\"MCP server\",\"c6beddad5ad8\",[473],[],{\"_60\":474,\"_21\":93,\"_94\":475,\"_96\":476},\"388a771640ef\",[],\"Developer-friendly tooling. Free tools like the SQL Optimizer, SQL Syntax Checker, and PostgreSQL Playground help developers build and debug faster.\",\"d5d63ddf6e25\",[480],[],{\"_60\":481,\"_21\":93,\"_94\":482,\"_96\":483},\"0f2b1589c157\",[],\"One workflow across clouds. The same console, API, Terraform provider, and Kubernetes operator work on AWS, GCP, Azure, DigitalOcean, UpCloud and OVHcloud.\",\"ae291e364c19\",[487],[],{\"_60\":488,\"_21\":93,\"_94\":489,\"_96\":490},\"008c1d645ea7\",[],\"Built-in observability. Grafana dashboards and Prometheus-compatible metrics out of the box, plus integrations with Datadog, New Relic, and others.\",\"6c777e4744a6\",[494],[],{\"_60\":495,\"_21\":93,\"_94\":496,\"_96\":497},\"56d4a4fb3c1f\",[],\"Running agents against operational data. Deploy containerized applications and AI agents alongside their Aiven data services. Same network, same governance, no separate infrastructure to stand up.\",\"836e638a6f02\",[501],[],{\"_60\":502,\"_21\":93,\"_94\":503,\"_96\":504},\"ee3c5f641cbc\",[],\"Removing the on-call load. Production plans provide automated daily backups with point-in-time recovery, zero-downtime version upgrades, automatic security patching, and a 99.99% uptime SLA.\",\"90c6f94739d8\",[508],[],{\"_60\":509,\"_21\":93,\"_94\":510,\"_96\":511},\"9c7420bf4b30\",[],\"Staying in the open source world. Every service runs the upstream version with standard drivers, APIs, and clients. Code written against Aiven works against a self-hosted instance, and vice versa. No proprietary SDKs to learn.\",\"05a3fde38f79\",[515],[],{\"_60\":516,\"_21\":93,\"_94\":517,\"_96\":518},\"7ad6c39b41c9\",[],\"Shipping faster. A new PostgreSQL, Kafka, or ClickHouse service is live in under 10 minutes. No tickets, no infra setup, no waiting on a platform team.\",\"b345244f6b5d\",[522],[],{\"_60\":523,\"_21\":93,\"_94\":524,\"_96\":525},\"c49033777000\",[],\"Concretely, the platform helps developers by:\",\"f8954720ab2b\",[529],[],{\"_60\":530,\"_21\":93,\"_94\":531,\"_96\":532},\"73ed39a66b1b\",[],\"Aiven removes the operational layer that usually sits between developers and the data tools they want to use. Instead of provisioning servers, writing config, setting up monitoring, and owning patch cycles, your team gets a production-ready service through one console or API call.\",\"7d3ef64a237a\",[536,537],\"What is the Aiven platform, and what does it do?\",{\"_60\":545,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":546,\"_86\":547,\"_88\":141},{\"_60\":538,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":539,\"_86\":540,\"_88\":141},\"1b09c2d51eb4\",[541],[],{\"_60\":542,\"_21\":93,\"_94\":543,\"_96\":544},\"2454758b06bd\",[],\"Aiven makes it easy to get started. You pick the services you need (PostgreSQL, Apache Kafka, ClickHouse, OpenSearch, DataHub, and others), choose a cloud provider and region, and Aiven has them running in minutes. From that point on, Aiven handles backups, security patches, version upgrades, and scaling automatically. Your developers connect to the service the same way they would to any standard open source tool, because it is one.\",\"edfb99c7604e\",[548],[],{\"_60\":549,\"_21\":93,\"_94\":550,\"_96\":551},\"d89139cb6807\",[],\"Aiven is an open data platform for production AI. It includes a suite of managed open source data services that lets your team deploy and run databases, streaming pipelines, search engines, and analytics services, without managing the underlying infrastructure. Aiven includes a governance and knowledge layer that gives developers, engineers, and AI agents the context they need to find, understand, and trust their data. The platform also includes a runtime environment where teams can deploy applications and agents alongside Aiven operational data.\",\"0a680a521b4b\",[555,556,557,558,559,560],\"Who is Aiven for?\",{\"_60\":596,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":597,\"_86\":598,\"_88\":141},{\"_60\":589,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":590,\"_167\":168,\"_169\":170,\"_86\":591,\"_88\":141},{\"_60\":582,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":583,\"_167\":168,\"_169\":170,\"_86\":584,\"_88\":141},{\"_60\":575,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":576,\"_167\":168,\"_169\":170,\"_86\":577,\"_88\":141},{\"_60\":568,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":569,\"_167\":168,\"_169\":170,\"_86\":570,\"_88\":141},{\"_60\":561,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":562,\"_86\":563,\"_88\":141},\"2285eb4fa6ac\",[564],[],{\"_60\":565,\"_21\":93,\"_94\":566,\"_96\":567},\"2a8c846b68d4\",[],\"Aiven powers AI, streaming, and analytical workloads across fintech (Dojo, Kroo Bank), retail (Decathlon, La Redoute, StockX), food delivery (Wolt), cybersecurity (Sophos, Claroty), travel (Priceline), and SaaS (WalkMe, Fiverr).\",\"7462acba6390\",[571],[],{\"_60\":572,\"_21\":93,\"_94\":573,\"_96\":574},\"9920aed8224f\",[],\"Startups: eligible startups can receive up to $100,000 in Aiven credits for 12 months, plus access to technical experts.\",\"80707793be57\",[578],[],{\"_60\":579,\"_21\":93,\"_94\":580,\"_96\":581},\"634a747a8bc0\",[],\"Solo developers, students, and side projects: the Free tier (no credit card) and the Developer tier, which gives you always-on managed services sized for development, prototyping, and MVPs on a small, predictable monthly fee. Current per-service prices are on the pricing page.\",\"77f03f8e472b\",[585],[],{\"_60\":586,\"_21\":93,\"_94\":587,\"_96\":588},\"8c982ed0b51c\",[],\"Scale-ups and mid-market teams: High availability, multi-cloud portability, and predictable all-inclusive TCO.\",\"cd9fcbc9aa13\",[592],[],{\"_60\":593,\"_21\":93,\"_94\":594,\"_96\":595},\"97c1897a7978\",[],\"Enterprise and regulated industries: SOC 2 Type II, ISO 27001, GDPR, and HIPAA-compliant infrastructure, plus Bring Your Own Cloud (BYOC) for teams with strict data residency, compliance, or cost requirements.\",\"50f0cff42716\",[599],[],{\"_60\":600,\"_21\":93,\"_94\":601,\"_96\":602},\"6d7af1242ca9\",[],\"Aiven is built for developers and engineering teams who need production-grade open source data infrastructure without the operational overhead. In practice, that spans:\",\"2d849e9afa35\",[606,607],\"Who is Aiven?\",{\"_60\":615,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":616,\"_86\":617,\"_88\":141},{\"_60\":608,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":609,\"_86\":610,\"_88\":141},\"b875c391ff30\",[611],[],{\"_60\":612,\"_21\":93,\"_94\":613,\"_96\":614},\"1806b1f26a27\",[],\"Aiven's mission is to free engineering teams from the operational burden of running open source data infrastructure, so they can focus on building data and AI products. Thousands of companies, including global enterprises like Priceline, Decathlon, Wolt, Sophos, and Fiverr, run their data infrastructure on Aiven.\",\"86e2d4fc8b65\",[618],[],{\"_60\":619,\"_21\":93,\"_94\":620,\"_96\":621},\"f92b7a15533a\",[],\"Aiven is an open source data platform company founded in 2016 in Helsinki, Finland, by Oskari Saarenmaa, Hannu Valtonen, Heikki Nousiainen, and Mika Eloranta. Today, Aiven has over 400 employees across offices in Helsinki, Berlin, Amsterdam, Paris, London, Singapore, Sydney, Auckland, Austin, and Toronto. The company is privately held and backed by investors including IVP, Atomico, Earlybird, Eurazeo, Salesforce Ventures, and World Innovation Lab.\",\"549ed29e42df\",\"cardList\",\"align\",\"left\",\"compact\",\"items\",[632,633,634],\"itemsPerRow\",3,\"Learn, Build, and Scale\",{\"_11\":12,\"_21\":635,\"_23\":669,\"_83\":670,\"_638\":671,\"_34\":672,\"_36\":673},{\"_11\":12,\"_21\":635,\"_23\":657,\"_83\":658,\"_638\":659,\"_34\":660,\"_36\":661},{\"_11\":12,\"_21\":635,\"_23\":636,\"_83\":637,\"_638\":639,\"_34\":640,\"_36\":641},\"webinar\",\"2026-10-08T11:33:24Z\",{\"_655\":656,\"_38\":646},\"publishedAt\",\"2026-10-07T15:00:00.000Z\",{\"_643\":644,\"_645\":-5},{\"_21\":36,\"_40\":642},\"/webinar/solving-real-ai-problems-using-valkey\",\"metaImage\",{\"_82\":646,\"_83\":647},\"metaImageText\",\"Solving Real AI Problems Using Valkey\",{\"_648\":-5,\"_649\":650,\"_651\":652,\"_653\":654},\"altText\",\"extension\",\"png\",\"originalFilename\",\"YouTube Thumbnail 1920x1080 v1 (5).png\",\"url\",\"https://cdn.sanity.io/images/sczeoy4w/production/464b1506cbdf928630a5e4717f4476c460244050-1920x1080.png\",\"summary\",\"Cut AI latency and token spend with Valkey. See how FT.SEARCH turns your cache into a semantic layer that catches near-duplicate prompts, live.\",\"2026-10-01T09:38:58Z\",{\"_655\":668,\"_38\":664},\"2026-09-30T09:15:00.000Z\",{\"_643\":663,\"_645\":-5},{\"_21\":36,\"_40\":662},\"/webinar/your-data-says-one-thing-your-ai-thinks-another\",{\"_82\":664,\"_83\":665},\"Your Data Says One Thing. Your AI Thinks Another.\",{\"_648\":-5,\"_649\":650,\"_651\":666,\"_653\":667},\"Meta SEO Preview - OpenSource.png\",\"https://cdn.sanity.io/images/sczeoy4w/production/4c00437fd05a46c697a2a9d67dd17a18c830fca5-1200x630.png\",\"AI agents don't reconcile messy product data, they act on it. Aiven + SFEIR show Retail + CPG teams how to build a governed foundation their agents can actually trust.\",\"2026-09-22T11:33:15Z\",{\"_655\":680,\"_38\":676},\"2026-09-21T14:00:00.000Z\",{\"_643\":675,\"_645\":-5},{\"_21\":36,\"_40\":674},\"/webinar/diskless-topics-on-aiven-for-apache-kafka\",{\"_82\":676,\"_83\":677},\"Diskless Topics on Aiven for Apache Kafka\",{\"_648\":-5,\"_649\":650,\"_651\":678,\"_653\":679},\"YouTube Thumbnail 1920x1080 v1 (3).png\",\"https://cdn.sanity.io/images/sczeoy4w/production/e180152041be2adfef7a5f92e574c1fc11650cbd-1920x1080.png\",\"Diskless moves Kafka replication into object storage, removing cross-AZ fees. See how diskless topics work, then create one live on Aiven for Apache Kafka.\",\"b3582af86815\",\"eventList\",\"center\",\"defaultEvents\",[703,704,705],\"limit\",{\"_21\":102,\"_427\":698,\"_105\":68,\"_106\":12,\"_36\":699,\"_38\":700},[692],\"tagline\",\"Upcoming events\",\"Ready to learn more?\",{\"_60\":693,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":694,\"_86\":-5,\"_88\":141},\"956222bf7aa0\",[695],{\"_60\":696,\"_21\":93,\"_96\":697},\"1b00e951f2f9\",\"Explore our online and in-person events and webinars to learn, connect, and discover all that Aiven has to offer.\",{\"_431\":702,\"_21\":433},{\"_21\":36,\"_40\":701},\"View all events\",\"/events\",\"5ee42446-6891-458b-bac8-fd25fa3fc6f2\",{\"_11\":12,\"_13\":952,\"_15\":953,\"_17\":954,\"_21\":709,\"_23\":955,\"_711\":68,\"_918\":919,\"_713\":956,\"_715\":957,\"_717\":68,\"_113\":958,\"_719\":720,\"_923\":959,\"_721\":-5,\"_722\":960,\"_71\":961,\"_927\":928,\"_34\":-5,\"_727\":962,\"_963\":964,\"_38\":965,\"_732\":709},{\"_11\":12,\"_13\":914,\"_15\":915,\"_17\":916,\"_21\":709,\"_23\":917,\"_711\":68,\"_918\":919,\"_713\":920,\"_715\":921,\"_717\":68,\"_113\":922,\"_719\":720,\"_923\":924,\"_721\":-5,\"_722\":925,\"_71\":926,\"_927\":928,\"_34\":-5,\"_727\":929,\"_689\":930,\"_38\":931,\"_732\":709},{\"_11\":12,\"_13\":706,\"_15\":707,\"_17\":708,\"_21\":709,\"_23\":710,\"_711\":30,\"_712\":-5,\"_713\":714,\"_715\":716,\"_717\":68,\"_113\":718,\"_719\":720,\"_721\":-5,\"_722\":723,\"_71\":724,\"_34\":725,\"_36\":726,\"_727\":728,\"_729\":730,\"_38\":731,\"_732\":635,\"_733\":30},\"2026-10-22T14:09:39Z\",\"92c572e4-9221-4765-90de-8ef01a3d73ec\",\"Gmh1gQ6bjs5J365rK8f2Nh\",\"event\",\"2026-10-23T10:12:40Z\",\"contentIsPage\",\"customEventTime\",\"description\",[906],\"endDate\",\"2026-11-11T15:45:00.000Z\",\"hideInEventPage\",{\"_21\":721,\"_83\":905},\"linkTitle\",\"Register\",\"mainImage\",\"pageType\",{\"_21\":753,\"_27\":754,\"_755\":756,\"_757\":758,\"_759\":760,\"_761\":731,\"_762\":113,\"_763\":68,\"_764\":765,\"_766\":68,\"_71\":767,\"_768\":769,\"_770\":30,\"_771\":772},{\"_21\":102,\"_746\":747,\"_748\":749,\"_105\":68,\"_106\":-5,\"_36\":-5},{\"_643\":742,\"_645\":-5},{\"_21\":36,\"_40\":741},\"startDate\",\"2026-11-11T15:00:00.000Z\",\"tags\",[734,735],\"Deploy Aiven’s Open Agentic Stack\",\"type\",\"virtualEvent\",{\"_60\":739,\"_431\":740,\"_21\":738},{\"_60\":736,\"_431\":737,\"_21\":738},\"3f70a9fd3703\",\"3c547914-626c-4ae5-8d0c-a0400bcc5e7f\",\"tag\",\"c0e33cbaba02\",\"60c1b0c8-37d8-4855-890d-a0c158f44f7f\",\"/events/deploy-aivens-open-agentic-stack\",{\"_82\":-5,\"_83\":743},{\"_648\":-5,\"_649\":650,\"_651\":744,\"_653\":745},\"YouTube Thumbnail 1920x1080 v3 (4).png\",\"https://cdn.sanity.io/images/sczeoy4w/production/5fd2fe482742edd3377fc77b1769abb0d6c50659-1920x1080.png\",\"experimentTitle\",{\"_21\":752,\"_751\":68},\"experimentUrl\",{\"_21\":750,\"_751\":68},\"experimentPath\",\"active\",\"experimentString\",\"eventPage\",[887],\"customHero\",{\"_886\":68},\"demioEvent\",{\"_21\":769,\"_882\":883,\"_884\":720,\"_38\":885},\"eventDetails\",[809,810,811,812,813,814,815,816,817],\"eventTitle\",\"heroVisualType\",\"heroWithCountdown\",\"iframeForm\",{\"_807\":808},\"isCaptionShown\",{\"_21\":102,\"_746\":805,\"_748\":806},\"registrationType\",\"demio\",\"replaceContent\",\"thankyouContent\",[773],{\"_60\":774,\"_21\":775,\"_776\":68,\"_777\":68,\"_778\":779,\"_780\":779,\"_781\":782,\"_783\":782,\"_67\":68,\"_784\":68,\"_113\":785,\"_786\":683,\"_787\":64,\"_788\":64,\"_69\":68,\"_70\":68,\"_789\":790,\"_96\":791,\"_38\":792,\"_793\":68,\"_77\":794},\"bie2g0ae9n6rmcaqmlqrxyhg103o1sxa\",\"textImage\",\"addSpaceBottom\",\"addSpaceTop\",\"backgroundPosition\",\"center center\",\"backgroundPositionMobile\",\"backgroundSize\",\"cover\",\"backgroundSizeMobile\",\"fullWidth\",{\"_21\":721,\"_82\":731,\"_83\":803},\"imagePosition\",\"mediaWidth\",\"mobileImageSetting\",\"roundedCorners\",\"rounded-none\",[795],\"Thank you for your interest!\",\"topOverlap\",\"mediaLeft\",{\"_60\":796,\"_21\":81,\"_84\":797,\"_86\":798,\"_88\":141},\"h1veqw108wo52v6a6a8r9lxiyft8rjo4\",[799],[],{\"_60\":800,\"_21\":93,\"_94\":801,\"_96\":802},\"1jh2p37nfbjk8ovonvcmxwjis3n019uj\",[],\"You will receive an email confirmation for your registration for the webinar.\",{\"_431\":804,\"_21\":433},\"image-5fd2fe482742edd3377fc77b1769abb0d6c50659-1920x1080-png\",{\"_21\":752,\"_751\":68},{\"_21\":750,\"_751\":68},\"iframeHeight\",800,{\"_60\":875,\"_21\":81,\"_84\":876,\"_86\":877,\"_88\":141},{\"_60\":868,\"_21\":81,\"_84\":869,\"_86\":870,\"_88\":141},{\"_60\":860,\"_21\":81,\"_84\":861,\"_86\":862,\"_88\":141},{\"_60\":853,\"_21\":81,\"_84\":854,\"_167\":168,\"_169\":170,\"_86\":855,\"_88\":141},{\"_60\":846,\"_21\":81,\"_84\":847,\"_167\":168,\"_169\":170,\"_86\":848,\"_88\":141},{\"_60\":839,\"_21\":81,\"_84\":840,\"_167\":168,\"_169\":170,\"_86\":841,\"_88\":141},{\"_60\":832,\"_21\":81,\"_84\":833,\"_167\":168,\"_169\":170,\"_86\":834,\"_88\":141},{\"_60\":825,\"_21\":81,\"_84\":826,\"_167\":168,\"_169\":170,\"_86\":827,\"_88\":141},{\"_60\":818,\"_21\":81,\"_84\":819,\"_167\":168,\"_169\":170,\"_86\":820,\"_88\":141},\"7418563f28f4\",[821],[],{\"_60\":822,\"_21\":93,\"_94\":823,\"_96\":824},\"2ee88d3d3758\",[],\"How to fork a ready-made template from templates.aiven.io and run the stack yourself\",\"b9427529ba66\",[828],[],{\"_60\":829,\"_21\":93,\"_94\":830,\"_96\":831},\"5d46346f976d\",[],\"The gotchas we hit while building the templates, and how to avoid them\",\"8bc2b07d1852\",[835],[],{\"_60\":836,\"_21\":93,\"_94\":837,\"_96\":838},\"e7f1e891f755\",[],\"How LLM observability shows what your agents are doing, call by call\",\"eaa22e5a8fc8\",[842],[],{\"_60\":843,\"_21\":93,\"_94\":844,\"_96\":845},\"9150288c756a\",[],\"How to deploy agents that keep running, and use durable workflows to recover when tasks fail\",\"8782c680e162\",[849],[],{\"_60\":850,\"_21\":93,\"_94\":851,\"_96\":852},\"581f4ac2ebc2\",[],\"How to route model calls through an AI gateway to control access, keys and spend\",\"2b0412575806\",[856],[],{\"_60\":857,\"_21\":93,\"_94\":858,\"_96\":859},\"f7c8f392c9b5\",[],\"What a production agentic stack needs beyond the model, and how each layer fits together\",\"b7e46bc9d497\",[863],[],{\"_60\":864,\"_21\":93,\"_94\":865,\"_96\":866},\"5699d6bd98ba\",[867],\"WHAT YOU’LL LEARN\",\"strong\",\"b00d6f8c307f\",[871],[],{\"_60\":872,\"_21\":93,\"_94\":873,\"_96\":874},\"9d5f7e8ac3a6\",[],\"Running AI agents in production takes more than a model and a prompt. In this live workshop, Jay Miller (Staff Product Advocate, Aiven) and Cara Baestlein (Director of Product, Apps, Aiven) deploy Aiven’s Open Agentic Stack step by step: an AI gateway, deployed agents, workflow orchestration and LLM observability, all running on Aiven Runtime next to your data.\",\"2f62e077086a\",[878],[],{\"_60\":879,\"_21\":93,\"_94\":880,\"_96\":881},\"cb7c7784ec87\",[867],\"Wednesday, 11 November 2026 · 17:00 EET (16:00 CET / 15:00 UTC / 10:00 ET)\",\"demioEventId\",\"vU5Wqbg8P9jCXYWz\",\"demioSubmitText\",\"Save your seat \",\"enabled\",{\"_60\":888,\"_21\":889,\"_624\":683,\"_890\":891,\"_63\":892,\"_893\":30,\"_894\":895,\"_67\":68,\"_69\":68,\"_70\":30,\"_896\":68,\"_38\":897,\"_77\":898},\"gzmh775l93coy6exp7uzeb509jxguqcy\",\"avatarList\",\"avatars\",[899,900],\"light-no-image\",\"bgOverflowClip\",\"crabbyIcon\",\"none\",\"showProfilePage\",\"Get to know our speakers\",\"withBio\",{\"_60\":903,\"_431\":904,\"_21\":433},{\"_60\":901,\"_431\":902,\"_21\":433},\"ba79d8441607\",\"4ab857b2-5a96-4d94-b58b-bbe9cd0d8bc0\",\"ca6c688facc1\",\"8cfcc5d4-1ef6-48c1-a50e-0d8445bf8ac7\",{\"_431\":804,\"_21\":433},{\"_60\":907,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":908,\"_86\":909,\"_88\":141},\"7a47ca242726\",[910],[],{\"_60\":911,\"_21\":93,\"_94\":912,\"_96\":913},\"3216e5abf64e\",[],\"Running AI agents in production takes more than a model and a prompt. You need a gateway to manage model access and costs, durable workflows that survive failures, observability to see what your agents are doing, and data services to give them memory and context.\\nIn this hands-on workshop, we’ll deploy Aiven’s Open Agentic Stack step by step: an AI gateway, deployed agents, workflow orchestration and LLM observability, running on Aiven Runtime next to your data. We’ll start from ready-made templates and show you the gotchas we hit while building them, so you don’t have to find them yourself.\\nYou’ll leave with a working stack you can fork, customise and run.\",\"2026-10-20T17:06:44Z\",\"327046fa-f125-4b7c-b3d0-ba21b910caa3\",\"wYL64A6ahSGKQd4z7bwP8i\",\"2026-10-20T18:07:03Z\",\"country\",\"US\",[944],\"2026-11-12T19:05:00.000Z\",{\"_21\":721,\"_83\":942},\"location\",\"Salt Palace Convention Center, Salt Lake City, UT\",{\"_21\":753,\"_755\":936,\"_757\":937,\"_762\":113,\"_763\":68,\"_764\":938,\"_766\":68,\"_71\":939,\"_770\":68},{\"_21\":102,\"_746\":932,\"_748\":933,\"_103\":934,\"_105\":68,\"_106\":-5,\"_36\":-5,\"_38\":935},\"region\",\"AMER\",\"2026-11-10T19:04:00.000Z\",\"Salt Lake City, UT\",\"KubeCon North America 2026\",{\"_21\":752,\"_751\":68},{\"_21\":750,\"_751\":68},\"https://events.linuxfoundation.org/kubecon-cloudnativecon-north-america\",\"Let's meet at the event!\",{\"_886\":68},{\"_21\":769,\"_884\":720},{\"_807\":808},{\"_21\":102,\"_746\":940,\"_748\":941},{\"_21\":752,\"_751\":68},{\"_21\":750,\"_751\":68},{\"_431\":943,\"_21\":433},\"image-e05073234336033fedec69dd8d6642386723ec89-800x400-png\",{\"_60\":945,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":946,\"_86\":947,\"_88\":141},\"832e1ece89d4\",[948],[],{\"_60\":949,\"_21\":93,\"_94\":950,\"_96\":951},\"10bedb358f60\",[],\"Meet with Aiven at KubeCon + CloudNativeCon North America 2026 and learn about Aiven services for open source data infrastructure. Find us at booth 336.\",\"2026-10-20T16:16:56Z\",\"3520fabf-1d64-45c4-a6fd-3b3c5e8663a9\",\"M05HR6Jw1AHBHOqSAXhpyF\",\"2026-10-20T16:21:31Z\",[1042],\"2026-11-05T17:17:00.000Z\",{\"_21\":721,\"_83\":1040},\"Moscone West, San Francisco, CA\",{\"_21\":753,\"_755\":1034,\"_757\":1035,\"_762\":113,\"_763\":68,\"_764\":1036,\"_766\":68,\"_71\":1037,\"_770\":68},{\"_21\":102,\"_746\":1031,\"_748\":1032,\"_103\":1033,\"_105\":68,\"_106\":-5,\"_36\":-5,\"_38\":935},\"2026-11-04T17:17:00.000Z\",\"talks\",[966],\"Current San Francisco 2026\",{\"_60\":967,\"_21\":968,\"_713\":969,\"_970\":971,\"_38\":972},\"74409fe18896\",\"talk\",[976,977,978,979,980,981,982],\"speakers\",[973],\"From Classic to Futuristic: Rolling out Diskless Topics with a Quality Program\",{\"_60\":974,\"_431\":975,\"_21\":433},\"f3fc9b0ee9f0\",\"9b15ab28-1216-42b4-b323-7f60f91c8130\",{\"_60\":1024,\"_21\":81,\"_84\":1025,\"_86\":1026,\"_88\":141},{\"_60\":1017,\"_21\":81,\"_84\":1018,\"_86\":1019,\"_88\":141},{\"_60\":1011,\"_21\":81,\"_84\":1012,\"_86\":1013,\"_88\":141},{\"_60\":1004,\"_21\":81,\"_84\":1005,\"_86\":1006,\"_88\":141},{\"_60\":997,\"_21\":81,\"_84\":998,\"_86\":999,\"_88\":141},{\"_60\":990,\"_21\":81,\"_84\":991,\"_86\":992,\"_88\":141},{\"_60\":983,\"_21\":81,\"_84\":984,\"_86\":985,\"_88\":141},\"bfc70639e0be\",[986],[],{\"_60\":987,\"_21\":93,\"_94\":988,\"_96\":989},\"f248ec2abe64\",[],\"\",\"4424961a2f07\",[993],[],{\"_60\":994,\"_21\":93,\"_94\":995,\"_96\":996},\"32c9d8e4c1be\",[],\"With this tool kit you can customize the quality program to fit your organization, and confidently bring Diskless to production to start reaping the benefits!\",\"72811e20edbd\",[1000],[],{\"_60\":1001,\"_21\":93,\"_94\":1002,\"_96\":1003},\"80bcb457253d\",[],\"This talk will describe a Diskless Technical Quality Program that you can implement to get your organization ready for Diskless Topics, and your applications onboarded. We’ll cover the basic prerequisites such as KRaft and Tiered Storage, and how to size and configure your Diskless infrastructure for your workloads. After that, we’ll discuss the mechanics of onboarding applications to Diskless with a phased roll-out, building confidence in the process and encouraging more adoption over time. Finally, we’ll talk about how to handle architecture limitations, unplanned downtime, and communicating with leadership to keep everyone informed.\",\"8b145b6cdcb9\",[1007],[],{\"_60\":1008,\"_21\":93,\"_94\":1009,\"_96\":1010},\"9ad89f0e143e\",[],\"If you’ve been thinking to yourself “How do I actually use KIP-1150?” you’re not alone. Someone has already shown you a picture of the transformative nature of Diskless Topics: Cheap, Scalable, High-throughput, and Easy-to-operate topics, with a trade-off of higher latency. Maybe you’ve read the KIP, and figured out how it delivers on its technical promises. Now you’re on-board with rolling it out in your organization, but the instruction manual to do so is missing. That’s what we’re here to share.\",\"0047a0445572\",[1014],[],{\"_60\":1015,\"_21\":93,\"_94\":1016,\"_96\":989},\"8d5c0344be40\",[],\"09d21f581955\",[1020],[],{\"_60\":1021,\"_21\":93,\"_94\":1022,\"_96\":1023},\"30f9f474a020\",[],\"Room 206\",\"acc34734f8cd\",[1027],[],{\"_60\":1028,\"_21\":93,\"_94\":1029,\"_96\":1030},\"1f1a0a3d2db1\",[],\"Thursday, November 5, 202610:30 AM - 11:15 AM\",{\"_21\":752,\"_751\":68},{\"_21\":750,\"_751\":68},\"https://current.confluent.io/san-francisco\",{\"_886\":68},{\"_21\":769,\"_884\":720},{\"_807\":808},{\"_21\":102,\"_746\":1038,\"_748\":1039},{\"_21\":752,\"_751\":68},{\"_21\":750,\"_751\":68},{\"_431\":1041,\"_21\":433},\"image-74919bb4dc5d51998d49770892fa18508d8b6f46-800x400-png\",{\"_60\":1043,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":1044,\"_86\":1045,\"_88\":141},\"825f7dcc1c45\",[1046],[],{\"_60\":1047,\"_21\":93,\"_94\":1048,\"_96\":1049},\"cb15e3cc23e8\",[],\"Meet with Aiven at Current San Francisco 2026 and learn about Aiven services for Apache Kafka. \",\"21369ec77a49\",\"testimonial\",\"dark-gradient-purple-smooth-bottom-left\",\"ctaLink\",\"isCarousel\",\"isHideMedia\",[1073,1074,1075],\"showCompanyLogoAndTags\",[1060],\"media\",{\"_60\":1061,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":1062,\"_86\":1063,\"_88\":1064},\"3b84523bb99c\",[1065,1066],[],\"h2\",{\"_60\":1070,\"_21\":93,\"_94\":1071,\"_96\":1072},{\"_60\":1067,\"_21\":93,\"_94\":1068,\"_96\":1069},\"b97660797433\",[98],\"builders.\",\"32056f4a929a\",[],\"Trusted by developers. Built for \",{\"_60\":1282,\"_21\":1077,\"_1078\":1283,\"_1080\":1284,\"_27\":1285,\"_1053\":1286,\"_113\":-5},{\"_60\":1192,\"_21\":1077,\"_1078\":1193,\"_1080\":1194,\"_27\":1195,\"_1053\":1196,\"_113\":-5},{\"_60\":1076,\"_21\":1077,\"_1078\":1079,\"_1080\":1081,\"_27\":1082,\"_1053\":1083,\"_113\":-5},\"9717a78bf00d\",\"testimonialItem\",\"company\",{\"_13\":1109,\"_15\":1110,\"_17\":1111,\"_19\":1112,\"_21\":1078,\"_23\":1113,\"_1114\":1115,\"_1116\":1117,\"_1118\":1108,\"_1119\":1120,\"_1121\":1122,\"_1123\":1124,\"_927\":1125,\"_729\":1126,\"_1127\":1128},\"companyHighlight\",[1096,1097],[1089],{\"_21\":102,\"_427\":1084,\"_105\":68,\"_106\":12,\"_36\":1085,\"_38\":1086},{\"_431\":1088,\"_21\":433},{\"_21\":36,\"_40\":1087},\"Read case study\",\"/case-studies/walkme-optimizes-business-critical-apache-kafkar-clusters\",\"ee2ef830-cdae-46ce-8a4d-7d01f8a0ff53\",{\"_60\":1090,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":1091,\"_86\":-5,\"_88\":1092},\"b4cf40574522\",[1093],\"blockquote\",{\"_60\":1094,\"_21\":93,\"_96\":1095},\"75ebf90480e6\",\"Thanks to tiered storage, we've reduced our Kafka storage by around 80% which has saved us a huge amount of money — and all without any latency issues.\",{\"_60\":1103,\"_21\":81,\"_84\":1104,\"_88\":1105},{\"_60\":1098,\"_21\":81,\"_84\":1099,\"_88\":141},\"e2e066c87c21\",[1100],{\"_60\":1101,\"_21\":93,\"_96\":1102},\"bdd59108c95c\",\"Slashed Kafka storage costs by 80% with Tiered Storage while handling over 100,000 events per second\",\"66e4a9619977\",[1106],\"h4\",{\"_60\":1107,\"_21\":93,\"_96\":1108},\"8bb22562a12e\",\"WalkMe\",\"2025-04-16T07:47:07Z\",\"3a9d2494-b757-460e-948a-918a959548bf\",\"UIzBTmPAVbl8XyiDBCTB5u\",{\"_1169\":1190},\"2025-10-03T14:45:22Z\",\"companyLogo\",{\"_21\":721,\"_83\":1188},\"companyLogoSquare\",{\"_21\":721,\"_83\":1186},\"companyName\",\"customerStory\",{\"_431\":1088,\"_21\":433},\"hostProviders\",[1183],\"logoHeight\",48,\"EMEA\",[1129,1130],\"yearFounded\",2011,{\"_11\":12,\"_13\":1174,\"_15\":1175,\"_17\":1176,\"_21\":1177,\"_23\":1178,\"_1179\":1180,\"_1181\":1182},{\"_11\":12,\"_13\":1131,\"_15\":1132,\"_1133\":1132,\"_17\":1134,\"_19\":1135,\"_21\":1136,\"_23\":1137,\"_1138\":1139,\"_713\":1140,\"_1141\":1142,\"_1143\":1144,\"_1145\":1146,\"_1147\":1148,\"_74\":1149,\"_1150\":1151,\"_689\":1152,\"_38\":1153},\"2022-08-25T11:37:37Z\",\"5383cbbd-be42-476d-9851-14f1a7621644\",\"_originalId\",\"2slO8zU6KxecG1358rSIoU\",{\"_1169\":1170},\"service\",\"2026-10-25T00:32:42Z\",\"cta\",{\"_21\":102,\"_427\":1166,\"_38\":1167},{\"_21\":1154,\"_1155\":1163,\"_12\":1164,\"_1158\":1165},\"externalId\",{\"_21\":36,\"_40\":1162},\"group\",\"stream\",\"icon\",{\"_21\":721,\"_83\":1160},\"orderRank\",\"0|0i0004:\",{\"_21\":1154,\"_1155\":1156,\"_12\":1157,\"_1158\":1159},\"supportedVersion\",\"4.3\",\"Aiven for\",\"Apache Kafka®\",\"localeText\",\"de\",\"Unterstützen Sie Ihre ereignisgesteuerte Architektur und Echtzeit-Datenstreaming-Pipelines mit Kafka as a Service der Unternehmensklasse.\",\"The real-time backbone that keeps AI data fresh.\",\"fr\",\"Alimentez votre architecture événementielle et vos pipelines de streaming de données en temps réel avec Kafka as a Service de niveau entreprise.\",{\"_431\":1161,\"_21\":433},\"image-541fb8e4c4c3b2b50141d78d66b3447e308cffe6-40x40-svg\",\"kafka\",\"Echtzeit-Datenströme\",\"Real-time data streams\",\"Flux de données en temps réel\",{\"_431\":1168,\"_21\":433},\"Learn more\",\"5e18872b-5613-4fc8-aaaa-0a36263634f5\",\"base\",{\"_1171\":1132,\"_1172\":1173},\"id\",\"rev\",\"uSeKzhyo2IW6greIMFdc2U\",\"2022-06-20T15:31:43Z\",\"b9ecd6d1-5e64-473a-9efc-416ea4596d01\",\"2a0x8ZFmDOgprY7cLywbaU\",\"industry\",\"2022-09-05T08:30:31Z\",\"label\",\"Software and Internet\",\"value\",\"software-and-internet\",{\"_60\":1184,\"_431\":1185,\"_21\":433},\"c20d74c94527\",\"adc248e9-c65b-45b5-a4e6-930767897444\",{\"_431\":1187,\"_21\":433},\"image-063c24fbb248d4b72a35734b09d5439b64ef5390-300x300-png\",{\"_431\":1189,\"_21\":433},\"image-dd5ac4cbc05fe2e89d1796983a0c60292b86da10-1555x525-png\",{\"_1171\":1110,\"_1172\":1191},\"lDg1aXFxSVKntzLqhCtDy7\",\"7b6b8d8fd83e\",{\"_13\":1219,\"_15\":1220,\"_17\":1221,\"_19\":1222,\"_21\":1078,\"_23\":1113,\"_1114\":1223,\"_1116\":1224,\"_1118\":1218,\"_1225\":1226,\"_1119\":1227,\"_1121\":1228,\"_1123\":1124,\"_927\":928,\"_729\":1229,\"_1127\":1230},[1207,1208],[1201],{\"_21\":102,\"_427\":1197,\"_105\":68,\"_106\":12,\"_36\":1198,\"_38\":1086},{\"_431\":1200,\"_21\":433},{\"_21\":36,\"_40\":1199},\"/case-studies/claroty-cuts-apache-kafka-costs-in-half-with-aiven-byoc\",\"60b23ae8-038f-4cec-b8bd-852af32d733c\",{\"_60\":1202,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":1203,\"_86\":-5,\"_88\":1092},\"696f94564a3e\",[1204],{\"_60\":1205,\"_21\":93,\"_96\":1206},\"c98d6ac50d9a\",\"We reduced the TCO of running our Apache Kafka clusters by 72% which equates to a saving of millions of dollars each year.\",{\"_60\":1214,\"_21\":81,\"_84\":1215,\"_88\":1105},{\"_60\":1209,\"_21\":81,\"_84\":1210,\"_88\":141},\"ea7174262775\",[1211],{\"_60\":1212,\"_21\":93,\"_96\":1213},\"f16550833a0a\",\"Cut Kafka TCO by 72% and saved millions annually with Aiven's Bring Your Own Cloud (BYOC)\",\"c493d4516b70\",[1216],{\"_60\":1217,\"_21\":93,\"_96\":1218},\"b13e59222e86\",\"Claroty\",\"2025-02-06T14:33:25Z\",\"066bbb45-bbb8-459d-8f4b-692df6902781\",\"g8eHHsLV7ci6mnlkLVrH2Y\",{\"_1169\":1280},{\"_21\":721,\"_83\":1278},{\"_21\":721,\"_83\":1276},\"companyWebsite\",\"https://claroty.com/\",{\"_431\":1200,\"_21\":433},[1273],[1231,1232,1233],2014,{\"_11\":12,\"_13\":1131,\"_15\":1132,\"_1133\":1132,\"_17\":1134,\"_19\":1264,\"_21\":1136,\"_23\":1137,\"_1138\":1265,\"_713\":1266,\"_1141\":1267,\"_1143\":1144,\"_1145\":1268,\"_1147\":1148,\"_74\":1269,\"_1150\":1151,\"_689\":1152,\"_38\":1153},{\"_11\":12,\"_13\":1240,\"_15\":1241,\"_1133\":1241,\"_17\":1134,\"_19\":1242,\"_21\":1136,\"_23\":1137,\"_1138\":1243,\"_713\":1244,\"_1141\":1245,\"_1143\":1246,\"_1145\":1247,\"_1147\":1248,\"_74\":1249,\"_1150\":1250,\"_689\":1152,\"_38\":1251},{\"_11\":12,\"_13\":1234,\"_15\":1235,\"_17\":1236,\"_21\":1177,\"_23\":1237,\"_1179\":1238,\"_1181\":1239},\"2025-02-06T15:50:57Z\",\"b10240cb-e79a-457a-bf4b-1e29f31a9a81\",\"JriWOQOSuSgSO7JWAQBg96\",\"2025-02-06T15:51:02Z\",\"Software\",\"software\",\"2022-08-25T11:38:18Z\",\"3d8215ce-236e-42c1-9599-a3f68ad67d6d\",{\"_1169\":1263},{\"_21\":102,\"_427\":1261},{\"_21\":1154,\"_1155\":1258,\"_12\":1259,\"_1158\":1260},{\"_21\":36,\"_40\":1257},\"store\",{\"_21\":721,\"_83\":1255},\"0|090002:\",{\"_21\":1154,\"_1155\":1252,\"_12\":1253,\"_1158\":1254},\"18.6\",\"PostgreSQL®\",\"Erstellen Sie skalierbare, ausfallsichere Anwendungen mit einer vollständig verwalteten, hochverfügbaren PostgreSQL-Datenbank als Service.\",\"Transactional data, the default place to start building AI.\",\"Créez des applications évolutives et résilientes avec une base de données PostgreSQL en tant que service, entièrement gérée et à haute disponibilité.\",{\"_431\":1256,\"_21\":433},\"image-a480fd4680fc8e1eec0d4754c3f26068af46666f-40x40-svg\",\"pg\",\"Mühelose Datenbank\",\"Effortless database\",\"Base de données sans effort\",{\"_431\":1262,\"_21\":433},\"a829737a-0ab2-4037-a7af-be5f9a4f82cf\",{\"_1171\":1241,\"_1172\":1173},{\"_1169\":1272},{\"_21\":102,\"_427\":1271,\"_38\":1167},{\"_21\":1154,\"_1155\":1163,\"_12\":1164,\"_1158\":1165},{\"_21\":36,\"_40\":1162},{\"_21\":721,\"_83\":1270},{\"_21\":1154,\"_1155\":1156,\"_12\":1157,\"_1158\":1159},{\"_431\":1161,\"_21\":433},{\"_431\":1168,\"_21\":433},{\"_1171\":1132,\"_1172\":1173},{\"_60\":1274,\"_431\":1275,\"_21\":433},\"706eb68cf83a\",\"080b4781-d7b8-4d95-8aa6-aeb4989bf5c6\",{\"_431\":1277,\"_21\":433},\"image-03aeb5aec284af9c0997bde173462221e7b3d905-150x151-svg\",{\"_431\":1279,\"_21\":433},\"image-3fb6cc369b97370df4b13f2c62d3d221806fe3ab-400x77-png\",{\"_1171\":1220,\"_1172\":1281},\"Ytv0u8p7Ex1SAq2Ta7wFeM\",\"125883035f32\",{\"_13\":1307,\"_15\":1308,\"_17\":1309,\"_19\":1310,\"_21\":1078,\"_23\":1311,\"_1114\":1312,\"_1116\":1313,\"_1118\":1306,\"_1225\":1314,\"_1119\":1315,\"_1121\":1316,\"_1123\":1317,\"_927\":1125,\"_729\":1318,\"_1127\":1319},[1295,1296],[1289],{\"_21\":102,\"_427\":1287,\"_105\":68,\"_106\":12,\"_36\":1288,\"_38\":1086},{\"_431\":432,\"_21\":433},{\"_21\":36,\"_40\":430},{\"_60\":1290,\"_21\":81,\"_82\":-5,\"_83\":-5,\"_84\":1291,\"_86\":-5,\"_88\":1092},\"ea32f8e141eb\",[1292],{\"_60\":1293,\"_21\":93,\"_96\":1294},\"a48a79c32a16\",\"The team used to spend up to 90% of the day doing maintenance, patching and upgrades. That's all handled by Aiven now, freeing up the team to focus on business projects.\",{\"_60\":1302,\"_21\":81,\"_84\":1