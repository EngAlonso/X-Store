{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/xstore/platform-backup/auto-run",
      "schedule": "0 * * * *"
    }
  ],
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/index.ts"
    },
    "x-store": {
      "root": "artifacts/x-store",
      "framework": "vite",
      "outputDirectory": "dist/public",
      "rewrites": [
        {
          "source": "/((?!.*\\.).*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "x-store"
      }
    }
  ]
}
